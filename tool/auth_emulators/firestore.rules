rules_version = '2';
// Rules of the private Firestore emulator of tool/start_auth_emulators.sh: nothing is readable or writable without
// a signed-in user, and a user only reaches the documents below users/<their uid>.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /signed_in/{document=**} {
      allow read, write: if request.auth != null;
    }
    // The claims of the ID token: a custom claim of a custom token, and the sign-in provider.
    match /testers/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'tester';
    }
    match /password_users/{document=**} {
      allow read, write: if request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email != null;
    }
  }
}
