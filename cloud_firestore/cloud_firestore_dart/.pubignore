# Files left out of the published package. When this file exists, pub does not
# read .gitignore in this directory, so the build output entries are repeated.
.dart_tool/
.packages
.pub/
build/
doc/api/
.idea/
*.iml
.DS_Store
.metadata
pubspec.lock

# Local development only: path override for firebase_app_dart.
pubspec_overrides.yaml

# Repository tooling and design notes (see the GitHub repository).
tool/
docs/
res/
firebase.json
firestore.rules

# Tests are not published: a dependency does not need them, they are most of the archive, and
# they need the repository anyway (fixtures in test/res, scripts in tool/, the emulators).
test/
