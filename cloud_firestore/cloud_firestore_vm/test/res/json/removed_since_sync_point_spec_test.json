{
  "Deleted documents in cache are fixed": {
    "config": {
      "numClients": 1,
      "useEagerGCForMemory": true
    },
    "describeName": "Listens:",
    "itName": "Deleted documents in cache are fixed",
    "steps": [
      {
        "expectedState": {
          "activeTargets": {
            "2": {
              "queries": [
                {
                  "filters": [
                    [
                      "key",
                      "==",
                      "a"
                    ]
                  ],
                  "orderBys": [],
                  "path": "collection"
                }
              ],
              "resumeToken": ""
            }
          }
        },
        "userListen": {
          "query": {
            "filters": [
              [
                "key",
                "==",
                "a"
              ]
            ],
            "orderBys": [],
            "path": "collection"
          },
          "targetId": 2
        }
      },
      {
        "watchAck": [
          2
        ]
      },
      {
        "watchEntity": {
          "docs": [
            {
              "key": "collection/a",
              "options": {
                "hasCommittedMutations": false,
                "hasLocalMutations": false
              },
              "value": {
                "key": "a"
              },
              "version": 1000
            }
          ],
          "targets": [
            2
          ]
        }
      },
      {
        "watchCurrent": [
          [
            2
          ],
          "resume-token-1000"
        ]
      },
      {
        "expectedSnapshotEvents": [
          {
            "added": [
              {
                "key": "collection/a",
                "options": {
                  "hasCommittedMutations": false,
                  "hasLocalMutations": false
                },
                "value": {
                  "key": "a"
                },
                "version": 1000
              }
            ],
            "errorCode": 0,
            "fromCache": false,
            "hasPendingWrites": false,
            "query": {
              "filters": [
                [
                  "key",
                  "==",
                  "a"
                ]
              ],
              "orderBys": [],
              "path": "collection"
            }
          }
        ],
        "watchSnapshot": {
          "targetIds": [],
          "version": 1000
        }
      },
      {
        "watchEntity": {
          "docs": [
            {
              "key": "collection/a",
              "value": null,
              "version": 2000
            }
          ],
          "removedTargets": [
            2
          ]
        }
      },
      {
        "watchSnapshot": {
          "resumeToken": "resume-token-2000",
          "targetIds": [
            2
          ],
          "version": 2000
        }
      },
      {
        "expectedSnapshotEvents": [
          {
            "errorCode": 0,
            "fromCache": false,
            "hasPendingWrites": false,
            "query": {
              "filters": [
                [
                  "key",
                  "==",
                  "a"
                ]
              ],
              "orderBys": [],
              "path": "collection"
            },
            "removed": [
              {
                "key": "collection/a",
                "options": {
                  "hasCommittedMutations": false,
                  "hasLocalMutations": false
                },
                "value": {
                  "key": "a"
                },
                "version": 1000
              }
            ]
          }
        ],
        "watchSnapshot": {
          "targetIds": [],
          "version": 2000
        }
      },
      {
        "expectedState": {
          "activeTargets": {}
        },
        "userUnlisten": [
          2,
          {
            "filters": [
              [
                "key",
                "==",
                "a"
              ]
            ],
            "orderBys": [],
            "path": "collection"
          }
        ]
      },
      {
        "watchRemove": {
          "targetIds": [
            2
          ]
        }
      },
      {
        "expectedState": {
          "activeTargets": {
            "4": {
              "queries": [
                {
                  "filters": [],
                  "orderBys": [],
                  "path": "collection"
                }
              ],
              "resumeToken": ""
            }
          }
        },
        "userListen": {
          "query": {
            "filters": [],
            "orderBys": [],
            "path": "collection"
          },
          "targetId": 4
        }
      },
      {
        "watchAck": [
          4
        ]
      },
      {
        "watchEntity": {
          "docs": [
            {
              "key": "collection/a",
              "options": {
                "hasCommittedMutations": false,
                "hasLocalMutations": false
              },
              "value": {
                "key": "a"
              },
              "version": 1000
            }
          ],
          "targets": [
            4
          ]
        }
      },
      {
        "watchCurrent": [
          [
            4
          ],
          "resume-token-3000"
        ]
      },
      {
        "expectedSnapshotEvents": [
          {
            "added": [
              {
                "key": "collection/a",
                "options": {
                  "hasCommittedMutations": false,
                  "hasLocalMutations": false
                },
                "value": {
                  "key": "a"
                },
                "version": 1000
              }
            ],
            "errorCode": 0,
            "fromCache": false,
            "hasPendingWrites": false,
            "query": {
              "filters": [],
              "orderBys": [],
              "path": "collection"
            }
          }
        ],
        "watchSnapshot": {
          "targetIds": [],
          "version": 3000
        }
      }
    ],
    "tags": ["eager-gc"]
  }
}